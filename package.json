{
  "name": "ai-tech-tree",
  "version": "1.3.0",
  "private": true,
  "description": "Interactive generative AI tech roadmap: from minerals and energy to applications, on a live timeline.",
  "keywords": [
    "generative-ai",
    "ai-roadmap",
    "technology-tree",
    "timeline",
    "data-visualization",
    "ai-infrastructure",
    "react",
    "typescript"
  ],
  "homepage": "https://seamys.github.io/ai-tech-tree/",
  "bugs": {
    "url": "https://github.com/seamys/ai-tech-tree/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seamys/ai-tech-tree.git"
  },
  "license": "MIT",
  "author": "seamys",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --serve",
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run validate && npm run typecheck && npm run test:unit",
    "test:unit": "node --test tests/unit/",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "agent": "node scripts/agent/index.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@types/d3-geo": "^3.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "playwright": "^1.63.0",
    "typescript": "7.0.2"
  }
}
